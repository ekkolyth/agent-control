{
    "name": "agent-control",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "license": "Apache-2.0",
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "apps/*",
        "packages/*",
        "e2e"
    ],
    "scripts": {
        "test": "bunx --bun vitest run",
        "typecheck": "bun run --filter '*' typecheck",
        "build": "bun run --filter '*' build",
        "e2e": "bun run --filter @agent-control/extension build && bun run --filter e2e test"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "typescript": "^5.6.0",
        "vitest": "^5.0.1"
    }
}
